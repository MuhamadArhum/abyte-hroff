# Server configuration — copy to .env and replace every placeholder.
NODE_ENV=production
PORT=4000

# REQUIRED: a random secret of at least 32 characters, unique per installation.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start with a short or example value.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# REQUIRED in production on a fresh database: a strong initial admin password
# (12+ chars, upper + lower + digit + symbol). The generated admin must change it on first login.
ADMIN_BOOTSTRAP_PASSWORD=

# Database (SQLite). Relative paths are resolved against server/prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Paths (relative to server/ or absolute). Ensure these directories are writable.
STORAGE_PATH=../storage
BACKUP_PATH=../storage/backups

# Comma-separated allowed origins, e.g. http://192.168.1.10:4000
CLIENT_URL=http://localhost:4000

# Set to true only behind one trusted reverse proxy. Never trust untrusted X-Forwarded-For.
TRUST_PROXY=false
